#!/usr/bin/env python3
"""Install, control, and inspect the LocalType Omarchy runtime."""

from __future__ import annotations

import fcntl
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.request
from datetime import datetime
from pathlib import Path


PLUGIN_ROOT = Path(__file__).resolve().parents[1]
HOME = Path.home()
DATA_HOME = Path(os.environ.get("LOCALTYPE_DATA_HOME", Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "localtype"))
LEGACY_HOME = Path(os.environ.get("LOCALTYPE_LEGACY_HOME", HOME / ".local/share/qwen3-asr"))
CONFIG_HOME = Path(os.environ.get("LOCALTYPE_CONFIG_HOME", Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "localtype"))
STATE_HOME = Path(os.environ.get("LOCALTYPE_STATE_HOME", Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "localtype"))
RUNTIME_HOME = Path(os.environ.get("LOCALTYPE_RUNTIME_HOME", Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "localtype"))
SYSTEMD_HOME = Path(os.environ.get("LOCALTYPE_SYSTEMD_HOME", HOME / ".config/systemd/user"))
HYPR_BINDINGS = Path(os.environ.get("LOCALTYPE_HYPR_BINDINGS", HOME / ".config/hypr/bindings.lua"))
LAUNCHER = Path(os.environ.get("LOCALTYPE_LAUNCHER", HOME / ".local/bin/localtypectl"))
DESKTOP_ENTRY = Path(
    os.environ.get(
        "LOCALTYPE_DESKTOP_ENTRY",
        Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "applications/localtype.desktop",
    )
)

TOGGLE = PLUGIN_ROOT / "runtime/toggle.sh"
STATE_HELPER = PLUGIN_ROOT / "runtime/state.py"
STORE_HELPER = PLUGIN_ROOT / "runtime/store.py"
REQUIREMENTS = PLUGIN_ROOT / "requirements.txt"
DICTIONARY_DEFAULT = PLUGIN_ROOT / "config/dictionary.json"
DICTIONARY = CONFIG_HOME / "dictionary.json"
STATE_FILE = STATE_HOME / "status.json"
SERVICE_FILE = SYSTEMD_HOME / "localtype.service"
RECORDING = RUNTIME_HOME / "recording.wav"
LOCK_FILE = RUNTIME_HOME / "install.lock"
SERVICE = "localtype.service"
RECORD_SERVICE = "localtype-record.service"
LEGACY_SERVICE = "qwen3-asr.service"
HEALTH_URL = os.environ.get("LOCALTYPE_HEALTH_URL", "http://127.0.0.1:8765/health")

BINDINGS_START = "-- >>> LocalType (managed; edit through the plugin)"
BINDINGS_END = "-- <<< LocalType"


def run(
    command: list[str],
    *,
    check: bool = False,
    timeout: float | None = None,
    input_text: str | None = None,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        command,
        text=True,
        capture_output=True,
        check=check,
        timeout=timeout,
        input=input_text,
    )


def command_exists(name: str) -> bool:
    return shutil.which(name) is not None


def unit_active(unit: str) -> bool:
    return run(["systemctl", "--user", "is-active", "--quiet", unit]).returncode == 0


def saved_state() -> dict:
    try:
        value = json.loads(STATE_FILE.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else {}
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return {}


def set_state(status: str, *, mode: str | None = None, detail: str | None = None, error: str | None = None) -> None:
    command = [str(STATE_HELPER), "set", status]
    if mode:
        command.extend(["--mode", mode])
    if detail is not None:
        command.extend(["--detail", detail])
    if error is not None:
        command.extend(["--error", error])
    run(command)


def health(timeout: float = 0.8) -> dict:
    try:
        with urllib.request.urlopen(HEALTH_URL, timeout=timeout) as response:
            value = json.load(response)
            return value if isinstance(value, dict) else {}
    except Exception:
        return {}


def gpu_status() -> dict:
    query = run([
        "nvidia-smi",
        "--query-gpu=name,memory.total,memory.used,utilization.gpu,temperature.gpu",
        "--format=csv,noheader,nounits",
    ]) if command_exists("nvidia-smi") else None
    if query is None or query.returncode != 0 or not query.stdout.strip():
        return {"available": False, "name": "CPU", "memory_total_mib": 0, "memory_used_mib": 0, "utilization": 0, "temperature_c": 0}
    fields = [field.strip() for field in query.stdout.splitlines()[0].split(",")]
    try:
        return {
            "available": True,
            "name": fields[0],
            "memory_total_mib": int(fields[1]),
            "memory_used_mib": int(fields[2]),
            "utilization": int(fields[3]),
            "temperature_c": int(fields[4]),
        }
    except (IndexError, ValueError):
        return {"available": False, "name": "GPU", "memory_total_mib": 0, "memory_used_mib": 0, "utilization": 0, "temperature_c": 0}


def selected_venv() -> Path:
    local = DATA_HOME / ".venv"
    legacy = LEGACY_HOME / ".venv"
    if local.exists():
        return local
    if legacy.exists():
        return legacy
    return local


def selected_hf_home() -> Path:
    local = DATA_HOME / "huggingface"
    legacy = LEGACY_HOME / "huggingface"
    if local.exists():
        return local
    if legacy.exists():
        return legacy
    return local


def systemd_quote(value: Path | str) -> str:
    return '"' + str(value).replace("\\", "\\\\").replace('"', '\\"') + '"'


def service_contents(venv: Path, hf_home: Path) -> str:
    return f"""[Unit]
Description=LocalType local smart dictation engine
After=graphical-session.target network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment={systemd_quote(f'HF_HOME={hf_home}')}
Environment={systemd_quote('CUDA_VISIBLE_DEVICES=0')}
Environment={systemd_quote(f'LOCALTYPE_DICTIONARY={DICTIONARY}')}
ExecStart={systemd_quote(venv / 'bin/uvicorn')} server:app --host 127.0.0.1 --port 8765
WorkingDirectory={PLUGIN_ROOT / 'runtime'}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
"""


def write_if_changed(path: Path, contents: str) -> bool:
    try:
        if path.read_text(encoding="utf-8") == contents:
            return False
    except FileNotFoundError:
        pass
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.tmp.{os.getpid()}")
    temporary.write_text(contents, encoding="utf-8")
    os.replace(temporary, path)
    return True


def install_launcher() -> None:
    LAUNCHER.parent.mkdir(parents=True, exist_ok=True)
    if LAUNCHER.is_symlink():
        if LAUNCHER.resolve() == Path(__file__).resolve():
            return
        LAUNCHER.unlink()
    elif LAUNCHER.exists():
        raise RuntimeError(f"refusing to replace existing launcher: {LAUNCHER}")
    LAUNCHER.symlink_to(Path(__file__).resolve())


def install_desktop_entry() -> None:
    contents = f"""[Desktop Entry]
Type=Application
Name=LocalType
GenericName=Local Voice Input
Comment=Local-first Chinese smart dictation
Exec={LAUNCHER} open
Icon=audio-input-microphone-symbolic
Terminal=false
Categories=Utility;AudioVideo;
Keywords=voice;dictation;Qwen;中文;语音输入;
StartupNotify=false
"""
    write_if_changed(DESKTOP_ENTRY, contents)


def managed_bindings() -> str:
    launcher = str(LAUNCHER)
    return (
        f"{BINDINGS_START}\n"
        'hl.unbind("F9")\n'
        f'o.bind("F9", "LocalType smart dictation", "{launcher} toggle smart")\n'
        f'o.bind("SHIFT + F9", "LocalType verbatim dictation", "{launcher} toggle raw")\n'
        f"{BINDINGS_END}\n"
    )


def strip_managed_bindings(contents: str) -> str:
    pattern = re.compile(
        rf"(?ms)^\s*{re.escape(BINDINGS_START)}\n.*?^\s*{re.escape(BINDINGS_END)}\s*\n?"
    )
    return pattern.sub("", contents)


def strip_legacy_bindings(contents: str) -> str:
    lines = contents.splitlines(keepends=True)
    result: list[str] = []
    skip_comment = False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("-- Qwen3-ASR dictation"):
            skip_comment = True
            continue
        if "qwen3-asr/toggle.sh" in line or '"Qwen3-ASR smart dictation"' in line or '"Qwen3-ASR verbatim dictation"' in line:
            continue
        if skip_comment and stripped == 'hl.unbind("F9")':
            skip_comment = False
            continue
        skip_comment = False
        result.append(line)
    return "".join(result)


def hypr_config_errors() -> str:
    if not command_exists("hyprctl"):
        return ""
    response = run(["hyprctl", "configerrors"], timeout=3)
    return response.stdout.strip() if response.returncode == 0 else ""


def install_bindings() -> None:
    if not HYPR_BINDINGS.exists():
        raise RuntimeError(f"Hyprland bindings file not found: {HYPR_BINDINGS}")
    original = HYPR_BINDINGS.read_text(encoding="utf-8")
    cleaned = strip_legacy_bindings(strip_managed_bindings(original)).rstrip() + "\n\n"
    updated = cleaned + managed_bindings()
    if updated == original:
        return
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    backup = HYPR_BINDINGS.with_name(f"{HYPR_BINDINGS.name}.bak.localtype-{stamp}")
    backup.write_text(original, encoding="utf-8")
    before_errors = hypr_config_errors()
    write_if_changed(HYPR_BINDINGS, updated)
    if command_exists("hyprctl"):
        run(["hyprctl", "reload"], timeout=5)
        after_errors = hypr_config_errors()
        if after_errors and after_errors != before_errors:
            write_if_changed(HYPR_BINDINGS, original)
            run(["hyprctl", "reload"], timeout=5)
            raise RuntimeError(f"Hyprland rejected LocalType bindings: {after_errors}")


def remove_bindings() -> None:
    if not HYPR_BINDINGS.exists():
        return
    original = HYPR_BINDINGS.read_text(encoding="utf-8")
    updated = strip_managed_bindings(original).rstrip() + "\n"
    if updated != original:
        write_if_changed(HYPR_BINDINGS, updated)
        if command_exists("hyprctl"):
            run(["hyprctl", "reload"], timeout=5)


def requirements_digest() -> str:
    return hashlib.sha256(REQUIREMENTS.read_bytes()).hexdigest()


def runtime_digest() -> str:
    digest = hashlib.sha256()
    for path in (PLUGIN_ROOT / "runtime/server.py", REQUIREMENTS):
        digest.update(path.read_bytes())
    return digest.hexdigest()


def install_python_runtime(venv: Path) -> None:
    marker = DATA_HOME / ".requirements.sha256"
    expected = requirements_digest()
    if not (venv / "bin/python").exists():
        set_state("installing", detail="Creating the Python environment")
        DATA_HOME.mkdir(parents=True, exist_ok=True)
        run(["uv", "venv", "--python", "3.12", str(venv)], check=True)
    current = marker.read_text(encoding="utf-8").strip() if marker.exists() else ""
    if current != expected:
        set_state("installing", detail="Installing the local AI runtime")
        run([
            "uv", "pip", "install", "--python", str(venv / "bin/python"),
            "--requirement", str(REQUIREMENTS),
        ], check=True)
        write_if_changed(marker, expected + "\n")


def ensure_default_config() -> None:
    CONFIG_HOME.mkdir(parents=True, exist_ok=True)
    if not DICTIONARY.exists():
        write_if_changed(DICTIONARY, DICTIONARY_DEFAULT.read_text(encoding="utf-8"))


def wait_until_ready(timeout_seconds: int = 900) -> bool:
    deadline = time.monotonic() + timeout_seconds
    while time.monotonic() < deadline:
        response = health(timeout=1.5)
        if response.get("status") == "ready":
            return True
        if run(["systemctl", "--user", "is-failed", "--quiet", SERVICE]).returncode == 0:
            return False
        time.sleep(2)
    return False


def ensure_runtime() -> int:
    missing = [
        name for name in ("uv", "systemctl", "pw-record", "wtype", "wl-copy", "jq", "curl", "notify-send", "hyprctl")
        if not command_exists(name)
    ]
    if missing:
        message = "Missing required commands: " + ", ".join(missing)
        set_state("error", error=message)
        print(message, file=sys.stderr)
        return 1

    RUNTIME_HOME.mkdir(parents=True, exist_ok=True)
    with LOCK_FILE.open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("LocalType installation is already running.")
            return 0

        try:
            set_state("installing", detail="Preparing LocalType")
            ensure_default_config()
            install_launcher()
            install_desktop_entry()
            install_bindings()

            venv = selected_venv()
            hf_home = selected_hf_home()
            install_python_runtime(venv)
            hf_home.mkdir(parents=True, exist_ok=True)
            unit_changed = write_if_changed(SERVICE_FILE, service_contents(venv, hf_home))
            runtime_marker = DATA_HOME / ".runtime.sha256"
            expected_runtime = runtime_digest()
            installed_runtime = runtime_marker.read_text(encoding="utf-8").strip() if runtime_marker.exists() else ""
            runtime_changed = installed_runtime != expected_runtime

            local_was_active = unit_active(SERVICE)
            legacy_was_active = unit_active(LEGACY_SERVICE)
            if legacy_was_active:
                run(["systemctl", "--user", "stop", LEGACY_SERVICE], check=True)

            if unit_changed:
                run(["systemctl", "--user", "daemon-reload"], check=True)
            if local_was_active and not unit_changed and not runtime_changed and health().get("status") == "ready":
                run(["systemctl", "--user", "disable", LEGACY_SERVICE])
                set_state("idle", detail="Ready")
                print("LocalType is installed and ready.")
                return 0

            set_state("starting", detail="Loading Qwen models on the GPU")
            enable = run(["systemctl", "--user", "enable", SERVICE])
            if enable.returncode != 0:
                raise RuntimeError(enable.stderr.strip() or "failed to enable LocalType service")
            start = run(["systemctl", "--user", "restart" if local_was_active else "start", SERVICE])
            if start.returncode != 0:
                if legacy_was_active:
                    run(["systemctl", "--user", "enable", "--now", LEGACY_SERVICE])
                raise RuntimeError(start.stderr.strip() or "failed to start LocalType service")

            if wait_until_ready():
                run(["systemctl", "--user", "disable", LEGACY_SERVICE])
                write_if_changed(runtime_marker, expected_runtime + "\n")
                set_state("idle", detail="Ready")
                print("LocalType is installed and ready.")
                return 0

            journal = run(["journalctl", "--user", "-u", SERVICE, "--no-pager", "-n", "12"]).stdout.strip()
            if legacy_was_active:
                run(["systemctl", "--user", "enable", "--now", LEGACY_SERVICE])
            raise RuntimeError("LocalType did not become ready." + ("\n" + journal if journal else ""))
        except Exception as error:
            set_state("error", error=str(error))
            print(str(error), file=sys.stderr)
            return 1


def print_status() -> None:
    fixture = os.environ.get("LOCALTYPE_STATUS_FIXTURE", "")
    if fixture:
        print(Path(fixture).read_text(encoding="utf-8").strip())
        return
    state = saved_state()
    service_active = unit_active(SERVICE)
    legacy_active = unit_active(LEGACY_SERVICE)
    recording = unit_active(RECORD_SERVICE)
    backend = health()
    phase = str(state.get("status", "idle"))
    if recording:
        phase = "recording"
    elif phase == "recording":
        phase = "idle"
    if not (service_active or legacy_active) and phase not in ("error", "installing"):
        phase = "offline"
    elif (service_active or legacy_active) and not backend and phase == "idle":
        phase = "starting"

    output = {
        "phase": phase,
        "mode": state.get("mode", "smart"),
        "detail": state.get("detail", ""),
        "service_active": service_active or legacy_active,
        "service_name": SERVICE if service_active else (LEGACY_SERVICE if legacy_active else ""),
        "backend_ready": backend.get("status") == "ready",
        "recording": recording,
        "recording_bytes": RECORDING.stat().st_size if RECORDING.exists() else 0,
        "asr_model": backend.get("asr_model", "Qwen3-ASR-1.7B"),
        "polisher_model": backend.get("polisher_model", "Qwen/Qwen3-0.6B"),
        "last_text": state.get("last_text", ""),
        "last_raw_text": state.get("last_raw_text", ""),
        "error": state.get("error", ""),
        "updated_at": state.get("updated_at", ""),
        "duration_ms": state.get("duration_ms", 0),
        "processing_ms": state.get("processing_ms", 0),
        "application_class": state.get("application_class", ""),
        "application_title": state.get("application_title", ""),
        "gpu": gpu_status(),
    }
    print(json.dumps(output, ensure_ascii=False, separators=(",", ":")))


def notify(title: str, body: str) -> None:
    subprocess.Popen(["notify-send", "-a", "LocalType", title, body])


def doctor() -> int:
    status = json.loads(run([str(Path(__file__).resolve()), "status"], check=True).stdout)
    checks = {
        "plugin": PLUGIN_ROOT.exists(),
        "manifest": (PLUGIN_ROOT / "manifest.json").exists(),
        "runtime": selected_venv().joinpath("bin/python").exists(),
        "service": bool(status["service_active"]),
        "backend": bool(status["backend_ready"]),
        "gpu": bool(status["gpu"].get("available")),
        "bindings": HYPR_BINDINGS.exists() and BINDINGS_START in HYPR_BINDINGS.read_text(encoding="utf-8"),
    }
    for name, passed in checks.items():
        print(f"{'OK' if passed else 'FAIL':4}  {name}")
    return 0 if all(checks.values()) else 1


def uninstall(purge: bool) -> int:
    run(["systemctl", "--user", "disable", "--now", SERVICE])
    if SERVICE_FILE.exists():
        SERVICE_FILE.unlink()
        run(["systemctl", "--user", "daemon-reload"])
    remove_bindings()
    if LAUNCHER.is_symlink() and LAUNCHER.resolve() == Path(__file__).resolve():
        LAUNCHER.unlink()
    if DESKTOP_ENTRY.exists():
        DESKTOP_ENTRY.unlink()
    if purge:
        shutil.rmtree(DATA_HOME, ignore_errors=True)
        shutil.rmtree(CONFIG_HOME, ignore_errors=True)
        shutil.rmtree(STATE_HOME, ignore_errors=True)
    print("LocalType runtime removed." + (" Models and settings were also deleted." if purge else " Models and settings were kept."))
    return 0


def main() -> int:
    command = sys.argv[1] if len(sys.argv) > 1 else "status"

    if command == "status":
        print_status()
        return 0
    if command == "open":
        if not command_exists("omarchy-shell"):
            print("omarchy-shell is not available", file=sys.stderr)
            return 1
        result = run(["omarchy-shell", "shell", "summon", "app.localtype.voice-input", "{}"])
        if result.returncode != 0:
            print(result.stderr.strip() or "failed to open LocalType", file=sys.stderr)
        return result.returncode
    if command in ("install", "ensure-runtime"):
        return ensure_runtime()
    if command == "doctor":
        return doctor()
    if command == "toggle":
        mode = sys.argv[2] if len(sys.argv) > 2 else "smart"
        if mode not in ("smart", "raw"):
            raise SystemExit("mode must be smart or raw")
        if not unit_active(SERVICE) and not unit_active(LEGACY_SERVICE):
            if ensure_runtime() != 0:
                return 1
        return subprocess.call([str(TOGGLE), mode])
    if command == "cancel":
        run(["systemctl", "--user", "stop", RECORD_SERVICE])
        try:
            RECORDING.unlink()
        except FileNotFoundError:
            pass
        set_state("idle", detail="Recording cancelled")
        notify("录音已取消", "没有输入任何文字")
        return 0
    if command in ("start", "stop", "restart"):
        if command in ("start", "restart") and not SERVICE_FILE.exists():
            return ensure_runtime()
        run(["systemctl", "--user", command, SERVICE], check=True)
        set_state("starting" if command != "stop" else "idle", detail="Loading models" if command != "stop" else "Service stopped")
        return 0
    if command == "clear-recent":
        run([str(STATE_HELPER), "clear"])
        return 0
    if command == "copy-recent":
        text = str(saved_state().get("last_text", ""))
        if text:
            run(["wl-copy"], check=True, input_text=text)
            notify("已复制", "最近一次听写已复制到剪贴板")
        return 0
    if command == "copy-text":
        text = sys.argv[2] if len(sys.argv) > 2 else ""
        if text:
            run(["wl-copy"], check=True, input_text=text)
            notify("已复制", "文字已复制到剪贴板")
        return 0
    store_commands = {
        "history-list",
        "history-add",
        "history-delete",
        "history-clear",
        "dictionary-list",
        "dictionary-set",
        "dictionary-delete",
        "scenes-list",
        "scene-toggle",
        "scene-set",
        "scene-save",
        "settings-show",
        "setting-set",
    }
    if command in store_commands:
        return subprocess.call([str(STORE_HELPER), *sys.argv[1:]])
    if command == "edit-dictionary":
        ensure_default_config()
        subprocess.Popen(["omarchy", "launch", "editor", str(DICTIONARY)])
        return 0
    if command == "uninstall":
        return uninstall("--purge" in sys.argv[2:])
    raise SystemExit(f"unknown command: {command}")


if __name__ == "__main__":
    raise SystemExit(main())
