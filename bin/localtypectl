#!/usr/bin/env python3
"""Install, control, and inspect the LocalType Omarchy runtime."""

from __future__ import annotations

import fcntl
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime
from pathlib import Path


PLUGIN_ROOT = Path(__file__).resolve().parents[1]
HOME = Path.home()
DATA_HOME = Path(os.environ.get("LOCALTYPE_DATA_HOME", Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "localtype"))
LEGACY_HOME = Path(os.environ.get("LOCALTYPE_LEGACY_HOME", HOME / ".local/share/qwen3-asr"))
CONFIG_HOME = Path(os.environ.get("LOCALTYPE_CONFIG_HOME", Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "localtype"))
STATE_HOME = Path(os.environ.get("LOCALTYPE_STATE_HOME", Path(os.environ.get("XDG_STATE_HOME", HOME / ".local/state")) / "localtype"))
RUNTIME_HOME = Path(os.environ.get("LOCALTYPE_RUNTIME_HOME", Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "localtype"))
SYSTEMD_HOME = Path(os.environ.get("LOCALTYPE_SYSTEMD_HOME", HOME / ".config/systemd/user"))
HYPR_BINDINGS = Path(os.environ.get("LOCALTYPE_HYPR_BINDINGS", HOME / ".config/hypr/bindings.lua"))
HYPR_CONFIG = Path(os.environ.get("LOCALTYPE_HYPR_CONFIG", HOME / ".config/hypr/hyprland.lua"))
LAUNCHER = Path(os.environ.get("LOCALTYPE_LAUNCHER", HOME / ".local/bin/localtypectl"))
DESKTOP_ENTRY = Path(
    os.environ.get(
        "LOCALTYPE_DESKTOP_ENTRY",
        Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "applications/localtype.desktop",
    )
)

TOGGLE = PLUGIN_ROOT / "runtime/toggle.sh"
STATE_HELPER = PLUGIN_ROOT / "runtime/state.py"
STORE_HELPER = PLUGIN_ROOT / "runtime/store.py"
REQUIREMENTS = PLUGIN_ROOT / "requirements.txt"
DICTIONARY_DEFAULT = PLUGIN_ROOT / "config/dictionary.json"
DICTIONARY = CONFIG_HOME / "dictionary.json"
STATE_FILE = STATE_HOME / "status.json"
HISTORY_FILE = STATE_HOME / "history.json"
CORRECTIONS_FILE = CONFIG_HOME / "learned_corrections.json"
PIPELINE_LOG = STATE_HOME / "pipeline.jsonl"
SETTINGS_FILE = CONFIG_HOME / "settings.json"
SERVICE_FILE = SYSTEMD_HOME / "localtype.service"
RECORDING = RUNTIME_HOME / "recording.wav"
STREAM_SESSION = RUNTIME_HOME / "stream-session"
LOCK_FILE = RUNTIME_HOME / "install.lock"
SERVICE = "localtype.service"
RECORD_SERVICE = "localtype-record.service"
LEGACY_SERVICE = "qwen3-asr.service"
HEALTH_URL = os.environ.get("LOCALTYPE_HEALTH_URL", "http://127.0.0.1:8765/health")

BINDINGS_START = "-- >>> LocalType (managed; edit through the plugin)"
BINDINGS_END = "-- <<< LocalType"
WINDOWS_START = "-- >>> LocalType window (managed; edit through the plugin)"
WINDOWS_END = "-- <<< LocalType window"


def run(
    command: list[str],
    *,
    check: bool = False,
    timeout: float | None = None,
    input_text: str | None = None,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        command,
        text=True,
        capture_output=True,
        check=check,
        timeout=timeout,
        input=input_text,
    )


def command_exists(name: str) -> bool:
    return shutil.which(name) is not None


def unit_active(unit: str) -> bool:
    return run(["systemctl", "--user", "is-active", "--quiet", unit]).returncode == 0


def saved_state() -> dict:
    try:
        value = json.loads(STATE_FILE.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else {}
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return {}


def saved_settings() -> dict:
    try:
        value = json.loads(SETTINGS_FILE.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else {}
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return {}


def language() -> str:
    return "zh" if saved_settings().get("language") == "zh" else "en"


def localized(english: str, chinese: str) -> str:
    return chinese if language() == "zh" else english


def set_state(status: str, *, mode: str | None = None, detail: str | None = None, error: str | None = None) -> None:
    command = [str(STATE_HELPER), "set", status]
    if mode:
        command.extend(["--mode", mode])
    if detail is not None:
        command.extend(["--detail", detail])
    if error is not None:
        command.extend(["--error", error])
    run(command)


def health(timeout: float = 0.8) -> dict:
    try:
        with urllib.request.urlopen(HEALTH_URL, timeout=timeout) as response:
            value = json.load(response)
            return value if isinstance(value, dict) else {}
    except Exception:
        return {}


def read_json_list(path: Path) -> list[dict]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return [entry for entry in value if isinstance(entry, dict)] if isinstance(value, list) else []
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return []


def enroll_acoustic_corrections(corrections: list[dict]) -> tuple[int, list[str]]:
    """Ask the loaded backend to align and store audio for learned edits."""
    if saved_settings().get("acoustic_learning") is not True:
        return 0, []
    histories = {
        str(entry.get("id", "")): entry
        for entry in read_json_list(HISTORY_FILE)
    }
    endpoint = f"{HEALTH_URL.rsplit('/health', 1)[0]}/acoustic/enroll"
    learned = 0
    errors: list[str] = []
    for correction in corrections:
        if correction.get("status") != "learned":
            continue
        history = histories.get(str(correction.get("history_id", "")))
        audio_path = str(history.get("audio_path", "")) if history else ""
        if not history or not audio_path or not Path(audio_path).is_file():
            continue
        payload = urllib.parse.urlencode(
            {
                "correction_id": str(correction.get("id", "")),
                "history_id": str(history.get("id", "")),
                "spoken": str(correction.get("spoken", "")),
                "written": str(correction.get("written", "")),
                "original_text": str(correction.get("original_text", history.get("final_text", ""))),
                "raw_text": str(history.get("raw_text", "")),
                "audio_path": audio_path,
                "application_class": str(correction.get("application_class", history.get("application_class", ""))),
                "source_start": int(correction.get("source_start", 0)),
                "source_end": int(correction.get("source_end", 0)),
            }
        ).encode("utf-8")
        request = urllib.request.Request(endpoint, data=payload, method="POST")
        try:
            with urllib.request.urlopen(request, timeout=600) as response:
                result = json.load(response)
            if result.get("status") == "learned":
                learned += 1
        except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, OSError) as error:
            errors.append(f"{correction.get('written', '')}: {error}")
    return learned, errors


def gpu_status() -> dict:
    query = run([
        "nvidia-smi",
        "--query-gpu=name,memory.total,memory.used,utilization.gpu,temperature.gpu",
        "--format=csv,noheader,nounits",
    ]) if command_exists("nvidia-smi") else None
    if query is None or query.returncode != 0 or not query.stdout.strip():
        return {"available": False, "name": "CPU", "memory_total_mib": 0, "memory_used_mib": 0, "utilization": 0, "temperature_c": 0}
    fields = [field.strip() for field in query.stdout.splitlines()[0].split(",")]
    try:
        return {
            "available": True,
            "name": fields[0],
            "memory_total_mib": int(fields[1]),
            "memory_used_mib": int(fields[2]),
            "utilization": int(fields[3]),
            "temperature_c": int(fields[4]),
        }
    except (IndexError, ValueError):
        return {"available": False, "name": "GPU", "memory_total_mib": 0, "memory_used_mib": 0, "utilization": 0, "temperature_c": 0}


def selected_venv() -> Path:
    local = DATA_HOME / ".venv"
    legacy = LEGACY_HOME / ".venv"
    if local.exists():
        return local
    if legacy.exists():
        return legacy
    return local


def selected_hf_home() -> Path:
    local = DATA_HOME / "huggingface"
    legacy = LEGACY_HOME / "huggingface"
    if local.exists():
        return local
    if legacy.exists():
        return legacy
    return local


def systemd_quote(value: Path | str) -> str:
    return '"' + str(value).replace("\\", "\\\\").replace('"', '\\"') + '"'


def python_module_installed(venv: Path, module: str) -> bool:
    site_packages = venv / "lib" / "python3.12" / "site-packages"
    return (site_packages / module).exists() or any(site_packages.glob(f"{module}-*.dist-info"))


def service_contents(venv: Path, hf_home: Path) -> str:
    asr_backend = "vllm" if python_module_installed(venv, "vllm") else "transformers"
    return f"""[Unit]
Description=LocalType local smart dictation engine
After=graphical-session.target network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment={systemd_quote(f'HF_HOME={hf_home}')}
Environment={systemd_quote('CUDA_VISIBLE_DEVICES=0')}
Environment={systemd_quote(f'LOCALTYPE_ASR_BACKEND={asr_backend}')}
Environment={systemd_quote('LOCALTYPE_VLLM_GPU_MEMORY_UTILIZATION=0.62')}
Environment={systemd_quote('LOCALTYPE_VLLM_MAX_MODEL_LEN=4096')}
Environment={systemd_quote('LOCALTYPE_VLLM_MAX_BATCHED_TOKENS=512')}
Environment={systemd_quote('VLLM_WORKER_MULTIPROC_METHOD=spawn')}
Environment={systemd_quote('VLLM_LOGGING_LEVEL=WARNING')}
Environment={systemd_quote(f'LOCALTYPE_DICTIONARY={DICTIONARY}')}
Environment={systemd_quote(f'LOCALTYPE_SETTINGS={SETTINGS_FILE}')}
Environment={systemd_quote(f'LOCALTYPE_STATE_HOME={STATE_HOME}')}
Environment={systemd_quote(f'LOCALTYPE_ACOUSTIC_HOME={STATE_HOME / "acoustic-memory"}')}
ExecStart={systemd_quote(venv / 'bin/uvicorn')} server:app --host 127.0.0.1 --port 8765
WorkingDirectory={PLUGIN_ROOT / 'runtime'}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
"""


def write_if_changed(path: Path, contents: str) -> bool:
    try:
        if path.read_text(encoding="utf-8") == contents:
            return False
    except FileNotFoundError:
        pass
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.tmp.{os.getpid()}")
    temporary.write_text(contents, encoding="utf-8")
    os.replace(temporary, path)
    return True


def install_launcher() -> None:
    LAUNCHER.parent.mkdir(parents=True, exist_ok=True)
    if LAUNCHER.is_symlink():
        if LAUNCHER.resolve() == Path(__file__).resolve():
            return
        LAUNCHER.unlink()
    elif LAUNCHER.exists():
        raise RuntimeError(f"refusing to replace existing launcher: {LAUNCHER}")
    LAUNCHER.symlink_to(Path(__file__).resolve())


def install_desktop_entry() -> None:
    contents = f"""[Desktop Entry]
Type=Application
Name=LocalType
GenericName=Local Voice Input
Comment=Local-first Chinese smart dictation
Exec={LAUNCHER} open
Icon=audio-input-microphone-symbolic
Terminal=false
Categories=Utility;AudioVideo;
Keywords=voice;dictation;Qwen;中文;语音输入;
StartupNotify=false
"""
    write_if_changed(DESKTOP_ENTRY, contents)


def normalize_shortcut(value: str) -> str:
    shortcut = re.sub(r"\s*\+\s*", " + ", value.strip().upper())
    shortcut = re.sub(r"\s+", " ", shortcut)
    if not shortcut or len(shortcut) > 48 or not re.fullmatch(r"[A-Z0-9 +_-]+", shortcut):
        raise ValueError("Shortcut may only contain key names, numbers, spaces, +, _ and -")
    return shortcut


def configured_shortcuts() -> tuple[str, str, str]:
    settings = saved_settings()
    return (
        normalize_shortcut(str(settings.get("smart_shortcut", "F9"))),
        normalize_shortcut(str(settings.get("raw_shortcut", "SHIFT + F9"))),
        normalize_shortcut(str(settings.get("learn_shortcut", "CTRL + SHIFT + F9"))),
    )


def managed_bindings() -> str:
    launcher = str(LAUNCHER)
    smart_shortcut, raw_shortcut, learn_shortcut = configured_shortcuts()
    return (
        f"{BINDINGS_START}\n"
        f'hl.unbind("{smart_shortcut}")\n'
        f'hl.unbind("{raw_shortcut}")\n'
        f'hl.unbind("{learn_shortcut}")\n'
        f'o.bind("{smart_shortcut}", "LocalType smart dictation", "{launcher} toggle smart")\n'
        f'o.bind("{raw_shortcut}", "LocalType verbatim dictation", "{launcher} toggle raw")\n'
        f'o.bind("{learn_shortcut}", "LocalType learn correction", "{launcher} learn-correction")\n'
        f"{BINDINGS_END}\n"
    )


def strip_managed_bindings(contents: str) -> str:
    pattern = re.compile(
        rf"(?ms)^\s*{re.escape(BINDINGS_START)}\n.*?^\s*{re.escape(BINDINGS_END)}\s*\n?"
    )
    return pattern.sub("", contents)


def strip_legacy_bindings(contents: str) -> str:
    lines = contents.splitlines(keepends=True)
    result: list[str] = []
    skip_comment = False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("-- Qwen3-ASR dictation"):
            skip_comment = True
            continue
        if "qwen3-asr/toggle.sh" in line or '"Qwen3-ASR smart dictation"' in line or '"Qwen3-ASR verbatim dictation"' in line:
            continue
        if skip_comment and stripped == 'hl.unbind("F9")':
            skip_comment = False
            continue
        skip_comment = False
        result.append(line)
    return "".join(result)


def hypr_config_errors() -> str:
    if not command_exists("hyprctl"):
        return ""
    response = run(["hyprctl", "configerrors"], timeout=3)
    return response.stdout.strip() if response.returncode == 0 else ""


def install_bindings() -> None:
    if not HYPR_BINDINGS.exists():
        raise RuntimeError(f"Hyprland bindings file not found: {HYPR_BINDINGS}")
    original = HYPR_BINDINGS.read_text(encoding="utf-8")
    cleaned = strip_legacy_bindings(strip_managed_bindings(original)).rstrip() + "\n\n"
    updated = cleaned + managed_bindings()
    if updated == original:
        return
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    backup = HYPR_BINDINGS.with_name(f"{HYPR_BINDINGS.name}.bak.localtype-{stamp}")
    backup.write_text(original, encoding="utf-8")
    before_errors = hypr_config_errors()
    write_if_changed(HYPR_BINDINGS, updated)
    if command_exists("hyprctl"):
        run(["hyprctl", "reload"], timeout=5)
        after_errors = hypr_config_errors()
        if after_errors and after_errors != before_errors:
            write_if_changed(HYPR_BINDINGS, original)
            run(["hyprctl", "reload"], timeout=5)
            raise RuntimeError(f"Hyprland rejected LocalType bindings: {after_errors}")


def remove_bindings() -> None:
    if not HYPR_BINDINGS.exists():
        return
    original = HYPR_BINDINGS.read_text(encoding="utf-8")
    updated = strip_managed_bindings(original).rstrip() + "\n"
    if updated != original:
        write_if_changed(HYPR_BINDINGS, updated)
        if command_exists("hyprctl"):
            run(["hyprctl", "reload"], timeout=5)


def managed_window_rules() -> str:
    return (
        f"{WINDOWS_START}\n"
        'o.window({ class = "^org\\\\.quickshell$", title = "^LocalType$" }, '
        '{ float = true, center = true, size = { 1400, 980 }, tag = "-default-opacity", opacity = "1 1" })\n'
        f"{WINDOWS_END}\n"
    )


def strip_managed_window_rules(contents: str) -> str:
    pattern = re.compile(
        rf"(?ms)^\s*{re.escape(WINDOWS_START)}\n.*?^\s*{re.escape(WINDOWS_END)}\s*\n?"
    )
    return pattern.sub("", contents)


def install_window_rules() -> None:
    if not HYPR_CONFIG.exists():
        raise RuntimeError(f"Hyprland config file not found: {HYPR_CONFIG}")
    original = HYPR_CONFIG.read_text(encoding="utf-8")
    updated = strip_managed_window_rules(original).rstrip() + "\n\n" + managed_window_rules()
    if updated == original:
        return
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    backup = HYPR_CONFIG.with_name(f"{HYPR_CONFIG.name}.bak.localtype-{stamp}")
    backup.write_text(original, encoding="utf-8")
    before_errors = hypr_config_errors()
    write_if_changed(HYPR_CONFIG, updated)
    if command_exists("hyprctl"):
        run(["hyprctl", "reload"], timeout=5)
        after_errors = hypr_config_errors()
        if after_errors and after_errors != before_errors:
            write_if_changed(HYPR_CONFIG, original)
            run(["hyprctl", "reload"], timeout=5)
            raise RuntimeError(f"Hyprland rejected LocalType window rule: {after_errors}")


def remove_window_rules() -> None:
    if not HYPR_CONFIG.exists():
        return
    original = HYPR_CONFIG.read_text(encoding="utf-8")
    updated = strip_managed_window_rules(original).rstrip() + "\n"
    if updated != original:
        write_if_changed(HYPR_CONFIG, updated)
        if command_exists("hyprctl"):
            run(["hyprctl", "reload"], timeout=5)


def requirements_digest() -> str:
    return hashlib.sha256(REQUIREMENTS.read_bytes()).hexdigest()


def runtime_digest() -> str:
    digest = hashlib.sha256()
    for path in (
        PLUGIN_ROOT / "runtime/server.py",
        PLUGIN_ROOT / "runtime/streaming_sessions.py",
        PLUGIN_ROOT / "runtime/acoustic_memory.py",
        PLUGIN_ROOT / "runtime/polish_guard.py",
        PLUGIN_ROOT / "runtime/prompt_defaults.py",
        PLUGIN_ROOT / "runtime/vocabulary.py",
        REQUIREMENTS,
    ):
        digest.update(path.read_bytes())
    return digest.hexdigest()


def install_python_runtime(venv: Path) -> None:
    marker = DATA_HOME / ".requirements.sha256"
    expected = requirements_digest()
    if not (venv / "bin/python").exists():
        set_state("installing", detail="Creating the Python environment")
        DATA_HOME.mkdir(parents=True, exist_ok=True)
        run(["uv", "venv", "--python", "3.12", str(venv)], check=True)
    current = marker.read_text(encoding="utf-8").strip() if marker.exists() else ""
    if current != expected:
        set_state("installing", detail="Installing the local AI runtime")
        run([
            "uv", "pip", "install", "--python", str(venv / "bin/python"),
            "--requirement", str(REQUIREMENTS),
        ], check=True)
        write_if_changed(marker, expected + "\n")


def ensure_default_config() -> None:
    CONFIG_HOME.mkdir(parents=True, exist_ok=True)
    if not DICTIONARY.exists():
        write_if_changed(DICTIONARY, DICTIONARY_DEFAULT.read_text(encoding="utf-8"))


def migrate_recent_history() -> None:
    if HISTORY_FILE.exists():
        return
    state = saved_state()
    final_text = str(state.get("last_text", "")).strip()
    if not final_text:
        return
    raw_text = str(state.get("last_raw_text", final_text)).strip() or final_text
    command = [
        str(STORE_HELPER),
        "history-add",
        "--mode",
        str(state.get("mode", "smart")),
        "--application-class",
        str(state.get("application_class", "")),
        "--application-title",
        str(state.get("application_title", "已迁移记录")),
        "--scene",
        "general",
        "--raw-text",
        raw_text,
        "--final-text",
        final_text,
        "--duration-ms",
        str(state.get("duration_ms", 0)),
        "--processing-ms",
        str(state.get("processing_ms", 0)),
        "--created-at",
        str(state.get("updated_at", "")),
    ]
    if raw_text != final_text:
        command.append("--polished")
    run(command)


def wait_until_ready(timeout_seconds: int = 900) -> bool:
    deadline = time.monotonic() + timeout_seconds
    while time.monotonic() < deadline:
        response = health(timeout=1.5)
        if response.get("status") == "ready":
            return True
        if run(["systemctl", "--user", "is-failed", "--quiet", SERVICE]).returncode == 0:
            return False
        time.sleep(2)
    return False


def ensure_runtime() -> int:
    missing = [
        name for name in ("uv", "systemctl", "pw-record", "wtype", "wl-copy", "jq", "curl", "notify-send", "hyprctl")
        if not command_exists(name)
    ]
    if missing:
        message = "Missing required commands: " + ", ".join(missing)
        set_state("error", error=message)
        print(message, file=sys.stderr)
        return 1

    RUNTIME_HOME.mkdir(parents=True, exist_ok=True)
    with LOCK_FILE.open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("LocalType installation is already running.")
            return 0

        try:
            set_state("installing", detail="Preparing LocalType")
            ensure_default_config()
            migrate_recent_history()
            install_launcher()
            install_desktop_entry()
            install_bindings()
            install_window_rules()

            venv = selected_venv()
            hf_home = selected_hf_home()
            install_python_runtime(venv)
            hf_home.mkdir(parents=True, exist_ok=True)
            unit_changed = write_if_changed(SERVICE_FILE, service_contents(venv, hf_home))
            runtime_marker = DATA_HOME / ".runtime.sha256"
            expected_runtime = runtime_digest()
            installed_runtime = runtime_marker.read_text(encoding="utf-8").strip() if runtime_marker.exists() else ""
            runtime_changed = installed_runtime != expected_runtime

            local_was_active = unit_active(SERVICE)
            legacy_was_active = unit_active(LEGACY_SERVICE)
            if legacy_was_active:
                run(["systemctl", "--user", "stop", LEGACY_SERVICE], check=True)

            if unit_changed:
                run(["systemctl", "--user", "daemon-reload"], check=True)
            if local_was_active and not unit_changed and not runtime_changed and health().get("status") == "ready":
                run(["systemctl", "--user", "disable", LEGACY_SERVICE])
                set_state("idle", detail="Ready")
                print("LocalType is installed and ready.")
                return 0

            set_state("starting", detail="Loading Qwen models on the GPU")
            enable = run(["systemctl", "--user", "enable", SERVICE])
            if enable.returncode != 0:
                raise RuntimeError(enable.stderr.strip() or "failed to enable LocalType service")
            start = run(["systemctl", "--user", "restart" if local_was_active else "start", SERVICE])
            if start.returncode != 0:
                if legacy_was_active:
                    run(["systemctl", "--user", "enable", "--now", LEGACY_SERVICE])
                raise RuntimeError(start.stderr.strip() or "failed to start LocalType service")

            if wait_until_ready():
                run(["systemctl", "--user", "disable", LEGACY_SERVICE])
                write_if_changed(runtime_marker, expected_runtime + "\n")
                set_state("idle", detail="Ready")
                print("LocalType is installed and ready.")
                return 0

            journal = run(["journalctl", "--user", "-u", SERVICE, "--no-pager", "-n", "12"]).stdout.strip()
            if legacy_was_active:
                run(["systemctl", "--user", "enable", "--now", LEGACY_SERVICE])
            raise RuntimeError("LocalType did not become ready." + ("\n" + journal if journal else ""))
        except Exception as error:
            set_state("error", error=str(error))
            print(str(error), file=sys.stderr)
            return 1


def print_status() -> None:
    fixture = os.environ.get("LOCALTYPE_STATUS_FIXTURE", "")
    if fixture:
        print(Path(fixture).read_text(encoding="utf-8").strip())
        return
    state = saved_state()
    service_active = unit_active(SERVICE)
    legacy_active = unit_active(LEGACY_SERVICE)
    recording = unit_active(RECORD_SERVICE)
    backend = health()
    phase = str(state.get("status", "idle"))
    if recording:
        phase = "recording"
    elif phase == "recording":
        phase = "idle"
    if not (service_active or legacy_active) and phase not in ("error", "installing"):
        phase = "offline"
    elif (service_active or legacy_active) and not backend and phase == "idle":
        phase = "starting"

    output = {
        "phase": phase,
        "mode": state.get("mode", "smart"),
        "language": language(),
        "detail": state.get("detail", ""),
        "partial_text": state.get("partial_text", ""),
        "service_active": service_active or legacy_active,
        "service_name": SERVICE if service_active else (LEGACY_SERVICE if legacy_active else ""),
        "backend_ready": backend.get("status") == "ready",
        "recording": recording,
        "recording_bytes": RECORDING.stat().st_size if RECORDING.exists() else 0,
        "asr_model": backend.get("asr_model", "Qwen3-ASR-1.7B"),
        "asr_backend": backend.get("asr_backend", "transformers"),
        "asr_backend_requested": backend.get("asr_backend_requested", "transformers"),
        "asr_backend_error": backend.get("asr_backend_error", ""),
        "streaming_ready": backend.get("streaming_ready", False),
        "streaming_sessions": backend.get("streaming_sessions", 0),
        "streaming_warmup_ms": backend.get("streaming_warmup_ms", 0),
        "polisher_model": backend.get("polisher_model", "Qwen/Qwen3-0.6B"),
        "forced_aligner_model": backend.get("forced_aligner_model", "Qwen3-ForcedAligner-0.6B"),
        "forced_aligner_status": backend.get("forced_aligner_status", "not_loaded"),
        "acoustic_learning": backend.get("acoustic_learning", saved_settings().get("acoustic_learning", False)),
        "acoustic_templates": backend.get("acoustic_templates", 0),
        "acoustic_memory": backend.get("acoustic_memory", str(STATE_HOME / "acoustic-memory")),
        "last_text": state.get("last_text", ""),
        "last_raw_text": state.get("last_raw_text", ""),
        "error": state.get("error", ""),
        "updated_at": state.get("updated_at", ""),
        "duration_ms": state.get("duration_ms", 0),
        "processing_ms": state.get("processing_ms", 0),
        "application_class": state.get("application_class", ""),
        "application_title": state.get("application_title", ""),
        "pipeline_log": str(PIPELINE_LOG),
        "gpu": gpu_status(),
    }
    print(json.dumps(output, ensure_ascii=False, separators=(",", ":")))


def print_overlay_status() -> None:
    """Return only latency-sensitive state needed by the dictation overlay."""
    state = saved_state()
    recording = unit_active(RECORD_SERVICE)
    service_active = unit_active(SERVICE) or unit_active(LEGACY_SERVICE)
    phase = str(state.get("status", "idle"))
    if recording:
        phase = "recording"
    elif phase == "recording":
        phase = "idle"
    if not service_active and phase not in ("error", "installing"):
        phase = "offline"
    output = {
        "phase": phase,
        "mode": state.get("mode", "smart"),
        "language": language(),
        "detail": state.get("detail", ""),
        "partial_text": state.get("partial_text", ""),
        "service_active": service_active,
        "backend_ready": service_active,
        "recording": recording,
        "error": state.get("error", ""),
    }
    print(json.dumps(output, ensure_ascii=False, separators=(",", ":")))


def print_pipeline_logs(limit: int) -> None:
    try:
        lines = PIPELINE_LOG.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        lines = []
    entries = []
    for line in lines[-limit:]:
        try:
            entries.append(json.loads(line))
        except json.JSONDecodeError:
            entries.append({"event": "invalid_log_line", "raw": line})
    print(json.dumps(entries, ensure_ascii=False, indent=2))


def notify(title: str, body: str) -> None:
    subprocess.Popen(["notify-send", "-a", "LocalType", title, body])


def refresh_overlay() -> None:
    if command_exists("omarchy-shell"):
        run(["omarchy-shell", "-q", "app.localtype.voice-input.overlay", "refresh"])


def cancel_stream_session() -> None:
    try:
        session_id = STREAM_SESSION.read_text(encoding="utf-8").strip()
    except OSError:
        session_id = ""
    try:
        STREAM_SESSION.unlink()
    except FileNotFoundError:
        pass
    if not session_id:
        return
    endpoint = f"{HEALTH_URL.rsplit('/health', 1)[0]}/stream/cancel"
    payload = urllib.parse.urlencode({"session_id": session_id}).encode("utf-8")
    request = urllib.request.Request(endpoint, data=payload, method="POST")
    try:
        urllib.request.urlopen(request, timeout=3).close()
    except (urllib.error.URLError, TimeoutError, OSError):
        pass


def active_window() -> tuple[str, str]:
    response = run(["hyprctl", "activewindow", "-j"])
    try:
        window = json.loads(response.stdout)
    except json.JSONDecodeError:
        window = {}
    return str(window.get("class", "")), str(window.get("title", ""))


def clipboard_text() -> str | None:
    result = run(["wl-paste", "--no-newline"], timeout=2)
    return result.stdout if result.returncode == 0 else None


def restore_clipboard(previous: str | None) -> None:
    if previous is None:
        run(["wl-copy", "--clear"])
    else:
        run(["wl-copy"], input_text=previous)


def learn_correction() -> int:
    """Capture selected corrected text and create reviewable learning candidates."""
    application_class, application_title = active_window()
    previous_clipboard = clipboard_text()
    terminal = bool(
        re.search(
            r"^(com\.mitchellh\.ghostty|Alacritty|kitty|foot|org\.wezfurlong\.wezterm)$",
            application_class,
        )
    )
    copy_keys = (
        ["wtype", "-M", "ctrl", "-M", "shift", "-k", "c", "-m", "shift", "-m", "ctrl"]
        if terminal
        else ["wtype", "-M", "ctrl", "-k", "c", "-m", "ctrl"]
    )
    copied = run(copy_keys)
    if copied.returncode != 0:
        notify(localized("Could not read selection", "无法读取选中文本"), localized("Select the complete corrected sentence and try again.", "请选择修改后的完整句子，然后重试。"))
        return 1
    time.sleep(0.18)
    corrected = clipboard_text()
    restore_clipboard(previous_clipboard)
    if corrected is None or not corrected.strip():
        notify(localized("Nothing selected", "没有选中文字"), localized("Select the complete corrected sentence, then press the learning shortcut.", "请选择修改后的完整句子，再按学习快捷键。"))
        return 1
    proposal = run(
        [
            str(STORE_HELPER),
            "correction-propose",
            "--corrected",
            corrected.strip(),
            "--application-class",
            application_class,
            "--application-title",
            application_title,
            "--source",
            "selection",
        ]
    )
    if proposal.returncode != 0:
        notify(localized("No correction found", "没有检测到可学习纠错"), proposal.stderr.strip() or localized("Select the complete corrected sentence and try again.", "请选择修改后的完整句子，然后重试。"))
        return proposal.returncode
    try:
        proposed = json.loads(proposal.stdout)
    except json.JSONDecodeError:
        proposed = []
    if proposed and all(item.get("status") == "learned" for item in proposed):
        acoustic_count, acoustic_errors = enroll_acoustic_corrections(proposed)
        if acoustic_count:
            detail = localized(
                "Text and its speech segment were added to personal memory.",
                "文字和对应语音片段已加入个人记忆。",
            )
        elif acoustic_errors:
            detail = localized(
                "Text was learned; the acoustic sample could not be aligned.",
                "文字已学习，但这次语音片段未能完成对齐。",
            )
        else:
            detail = localized(
                "The spelling will be biased in ASR and checked in sentence context next time.",
                "下次会在识别阶段优先考虑，并结合整句语义校对。",
            )
        notify(localized("Correction learned", "已学会这次纠错"), detail)
        return 0
    notify(localized("Correction ready to review", "纠错已等待确认"), localized("This edit was ambiguous; review it before LocalType learns it.", "这次修改存在歧义，请确认后再学习。"))
    opened = run([str(Path(__file__).resolve()), "open", "learning"])
    return opened.returncode


def doctor() -> int:
    status = json.loads(run([str(Path(__file__).resolve()), "status"], check=True).stdout)
    checks = {
        "plugin": PLUGIN_ROOT.exists(),
        "manifest": (PLUGIN_ROOT / "manifest.json").exists(),
        "runtime": selected_venv().joinpath("bin/python").exists(),
        "service": bool(status["service_active"]),
        "backend": bool(status["backend_ready"]),
        "streaming": bool(status.get("streaming_ready")),
        "gpu": bool(status["gpu"].get("available")),
        "bindings": HYPR_BINDINGS.exists() and BINDINGS_START in HYPR_BINDINGS.read_text(encoding="utf-8"),
    }
    for name, passed in checks.items():
        print(f"{'OK' if passed else 'FAIL':4}  {name}")
    return 0 if all(checks.values()) else 1


def uninstall(purge: bool) -> int:
    run(["systemctl", "--user", "disable", "--now", SERVICE])
    if SERVICE_FILE.exists():
        SERVICE_FILE.unlink()
        run(["systemctl", "--user", "daemon-reload"])
    remove_bindings()
    remove_window_rules()
    if LAUNCHER.is_symlink() and LAUNCHER.resolve() == Path(__file__).resolve():
        LAUNCHER.unlink()
    if DESKTOP_ENTRY.exists():
        DESKTOP_ENTRY.unlink()
    if purge:
        shutil.rmtree(DATA_HOME, ignore_errors=True)
        shutil.rmtree(CONFIG_HOME, ignore_errors=True)
        shutil.rmtree(STATE_HOME, ignore_errors=True)
    print("LocalType runtime removed." + (" Models and settings were also deleted." if purge else " Models and settings were kept."))
    return 0


def main() -> int:
    command = sys.argv[1] if len(sys.argv) > 1 else "status"

    if command == "status":
        print_status()
        return 0
    if command == "overlay-status":
        print_overlay_status()
        return 0
    if command == "open":
        if not command_exists("omarchy-shell"):
            print("omarchy-shell is not available", file=sys.stderr)
            return 1
        page = sys.argv[2] if len(sys.argv) > 2 else "workspace"
        if page not in {"workspace", "history", "dictionary", "learning", "scenes", "models", "settings"}:
            raise SystemExit("page must be workspace, history, dictionary, learning, scenes, models, or settings")
        payload = json.dumps({"page": page}, separators=(",", ":"))
        result = run(["omarchy-shell", "shell", "summon", "app.localtype.voice-input", payload])
        if result.returncode != 0:
            print(result.stderr.strip() or "failed to open LocalType", file=sys.stderr)
        return result.returncode
    if command in ("install", "ensure-runtime"):
        return ensure_runtime()
    if command == "doctor":
        return doctor()
    if command == "logs":
        try:
            limit = int(sys.argv[2]) if len(sys.argv) > 2 else 20
        except ValueError:
            raise SystemExit("usage: localtypectl logs [COUNT]")
        print_pipeline_logs(max(1, min(limit, 200)))
        return 0
    if command == "toggle":
        mode = sys.argv[2] if len(sys.argv) > 2 else "smart"
        if mode not in ("smart", "raw"):
            raise SystemExit("mode must be smart or raw")
        if not unit_active(SERVICE) and not unit_active(LEGACY_SERVICE):
            if ensure_runtime() != 0:
                return 1
        return subprocess.call([str(TOGGLE), mode])
    if command == "cancel":
        run(["systemctl", "--user", "stop", RECORD_SERVICE])
        cancel_stream_session()
        try:
            RECORDING.unlink()
        except FileNotFoundError:
            pass
        set_state("idle", detail="Recording cancelled")
        refresh_overlay()
        return 0
    if command in ("start", "stop", "restart"):
        if command in ("start", "restart") and not SERVICE_FILE.exists():
            return ensure_runtime()
        run(["systemctl", "--user", command, SERVICE], check=True)
        set_state("starting" if command != "stop" else "idle", detail="Loading models" if command != "stop" else "Service stopped")
        return 0
    if command == "clear-recent":
        run([str(STATE_HELPER), "clear"])
        return 0
    if command == "copy-recent":
        text = str(saved_state().get("last_text", ""))
        if text:
            run(["wl-copy"], check=True, input_text=text)
            notify(localized("Copied", "已复制"), localized("Latest dictation copied to the clipboard", "最近一次听写已复制到剪贴板"))
        return 0
    if command == "copy-text":
        text = sys.argv[2] if len(sys.argv) > 2 else ""
        if text:
            run(["wl-copy"], check=True, input_text=text)
            notify(localized("Copied", "已复制"), localized("Text copied to the clipboard", "文字已复制到剪贴板"))
        return 0
    if command == "learn-correction":
        return learn_correction()
    if command == "shortcuts-set":
        if len(sys.argv) < 4:
            raise SystemExit("usage: localtypectl shortcuts-set SMART RAW [LEARN]")
        try:
            smart_shortcut = normalize_shortcut(sys.argv[2])
            raw_shortcut = normalize_shortcut(sys.argv[3])
            learn_shortcut = normalize_shortcut(sys.argv[4] if len(sys.argv) > 4 else "CTRL + SHIFT + F9")
        except ValueError as error:
            print(str(error), file=sys.stderr)
            return 2
        if len({smart_shortcut, raw_shortcut, learn_shortcut}) != 3:
            print("Smart, verbatim, and learning shortcuts must be different", file=sys.stderr)
            return 2
        previous_smart, previous_raw, previous_learn = configured_shortcuts()
        result = run([str(STORE_HELPER), "shortcuts-set", smart_shortcut, raw_shortcut, learn_shortcut])
        if result.returncode != 0:
            print(result.stderr.strip(), file=sys.stderr)
            return result.returncode
        try:
            install_bindings()
        except Exception as error:
            run([str(STORE_HELPER), "shortcuts-set", previous_smart, previous_raw, previous_learn])
            try:
                install_bindings()
            except Exception:
                pass
            print(str(error), file=sys.stderr)
            return 1
        print(localized("Shortcuts updated", "快捷键已更新"))
        return 0
    if command == "correction-propose":
        result = run([str(STORE_HELPER), *sys.argv[1:]])
        if result.stdout:
            print(result.stdout, end="")
        if result.stderr:
            print(result.stderr, end="", file=sys.stderr)
        if result.returncode == 0:
            try:
                proposed = json.loads(result.stdout)
            except json.JSONDecodeError:
                proposed = []
            if isinstance(proposed, list):
                enroll_acoustic_corrections(proposed)
        return result.returncode
    if command == "correction-accept":
        result = run([str(STORE_HELPER), *sys.argv[1:]])
        if result.stdout:
            print(result.stdout, end="")
        if result.stderr:
            print(result.stderr, end="", file=sys.stderr)
        if result.returncode == 0 and len(sys.argv) > 2:
            correction = next(
                (entry for entry in read_json_list(CORRECTIONS_FILE) if entry.get("id") == sys.argv[2]),
                None,
            )
            if correction:
                enroll_acoustic_corrections([correction])
        return result.returncode
    store_commands = {
        "history-list",
        "history-add",
        "history-delete",
        "history-clear",
        "dictionary-list",
        "dictionary-set",
        "dictionary-delete",
        "corrections-list",
        "correction-ignore",
        "correction-delete",
        "scenes-list",
        "scene-toggle",
        "scene-set",
        "scene-save",
        "settings-show",
        "setting-set",
        "setting-reset",
    }
    if command in store_commands:
        return subprocess.call([str(STORE_HELPER), *sys.argv[1:]])
    if command == "edit-dictionary":
        ensure_default_config()
        subprocess.Popen(["omarchy", "launch", "editor", str(DICTIONARY)])
        return 0
    if command == "uninstall":
        return uninstall("--purge" in sys.argv[2:])
    raise SystemExit(f"unknown command: {command}")


if __name__ == "__main__":
    raise SystemExit(main())
